---
import '../styles/global.css';
import '../styles/motion.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site, href } from '../config/site';
const {
  title = site.name,
  description = site.description,
  wide = false,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title === site.name ? title : `${title} — ${site.name}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to main content
    </a>
    <SiteHeader />
    <main id="main" class:list={{ wide: wide }}>
      <slot />
    </main>
    <SiteFooter />
    <script>
      const reduce = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      if (!reduce && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const e of entries)
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                observer.unobserve(e.target);
              }
          },
          { threshold: 0.12 },
        );
        document
          .querySelectorAll('.reveal')
          .forEach((el) => observer.observe(el));
      }
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape')
          document
            .querySelectorAll<HTMLDetailsElement>('header details[open]')
            .forEach((el) => {
              el.open = false;
              el.querySelector('summary')?.focus();
            });
      });
      document.addEventListener('click', (e) =>
        document
          .querySelectorAll<HTMLDetailsElement>('header details[open]')
          .forEach((el) => {
            if (e.target instanceof Node && !el.contains(e.target))
              el.open = false;
          }),
      );
    </script>
  </body>
</html>
