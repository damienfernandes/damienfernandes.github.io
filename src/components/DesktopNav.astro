---
import { navigation, submenu } from '../config/navigation';
import { href } from '../config/site';
import Button from './Button.astro';
const isDev = import.meta.env.DEV;
---

<nav class="desktop-nav" aria-label="Primary navigation">
  {navigation.map((n) => (
    <a
      href={href(n.path)}
      aria-current={Astro.url.pathname === href(n.path) ? 'page' : undefined}
    >
      {n.label}
    </a>
  ))}
  <details class="dropdown">
    <summary>more</summary>
    <div class="dropdown-list">
      {submenu.map((n) => (
        <a href={href(n.path)}>{n.label}</a>
      ))}
      {isDev && <a href={href('/review/')}>review studio (local)</a>}
    </div>
  </details>
  <Button href={href('/atlas/')}>Explore the Atlas</Button>
</nav>
