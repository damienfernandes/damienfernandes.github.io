---
import Base from '../../layouts/Base.astro';
import '../../atlas/atlas.css';
import data from '../../../generated/public/atlas.json';
---

<Base title="Research Atlas" wide>
  <div class="atlas-shell wrap">
    <header class="atlas-heading">
      <div>
        <p class="eyebrow">Atlas / Public Edition</p>
        <h1>Connecting knowledge.</h1>
      </div>
      <p>
        Academic sources, methods, and papers.
        <br />
        Strictly validated public records (content may remain in French).
      </p>
    </header>
    <nav class="atlas-tabs" aria-label="Atlas views">
      <a href="#knowledge">Temporal Graph</a>
      <a href="#method">Methodology</a>
      <a href="#papers">Papers</a>
      <a href="#sources">Sources</a>
      <a href="#watch">Scientific Watch</a>
    </nav>
    <div class="atlas-toolbar">
      <label>
        Search
        <input
          type="search"
          id="atlas-search"
          placeholder="Title, author, research question…"
        />
      </label>
      <label>
        Up to year
        <select id="atlas-year">
          <option value="all">All years</option>
        </select>
      </label>
      <button class="button secondary" id="atlas-export" type="button">
        Export public JSON ↓
      </button>
    </div>
    <p id="atlas-count" aria-live="polite" class="muted"></p>
    <div class="atlas-layout">
      <section id="atlas-view" aria-label="Public records"></section>
      <aside id="atlas-detail" tabindex="-1" aria-label="Detailed record">
        <p class="eyebrow">Reading / Detail</p>
        <h2>Select an item.</h2>
        <p>Identifiers are always displayed alongside their full title.</p>
      </aside>
    </div>
    <noscript>
      <p>
        Interactive exploration requires JavaScript. Here are the available public records:
      </p>
      <ul>
        {[
          ...data.refs,
          ...data.blocks,
          ...data.papers,
          ...data.researchWatch,
        ].map((r: any) => (
          <li>
            {r.id} — {r.title || r.name}
          </li>
        ))}
      </ul>
    </noscript>
  </div>
  <script
    id="atlas-public-data"
    type="application/json"
    set:html={JSON.stringify(data).replace(/</g, '\u003c')}
  />
  <script>
    import '../../atlas/app';
  </script>
</Base>
