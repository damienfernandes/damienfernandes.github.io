---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import { cvData } from '../../data/cv';
import { getCollection } from 'astro:content';
import { href } from '../../config/site';

const cvEntries = await getCollection(
  'entries',
  (e) => e.data.public && e.data.section === 'cv',
);
---

<Base
  title="Curriculum Vitae"
  description={cvData.header.summary}
>
  <header class="page-head wrap cv-head-grid">
    <div>
      <p class="eyebrow">Explore / Curriculum Vitae</p>
      <h1>{cvData.header.name}</h1>
      <p class="lead">{cvData.header.title}</p>
      <p class="muted" style="margin-top:0.8rem">📍 {cvData.header.location}</p>
      <p style="max-width:64ch;margin-top:1.5rem">{cvData.header.summary}</p>
      <div class="hero-cta-group" style="margin-top:2rem">
        <Button href={cvData.header.linkedin}>
          LinkedIn Profile
        </Button>
        <Button href={cvData.header.github} secondary>
          GitHub Profile
        </Button>
      </div>
    </div>

    <figure class="profile-portrait-frame">
      <img
        src={href('/damien-fernandes.jpg')}
        alt={`Portrait of ${cvData.header.name}`}
        width="520"
        height="520"
        loading="eager"
        decoding="async"
        class="profile-portrait-img"
      />
    </figure>
  </header>

  <div class="wrap">
    <section class="section topline">
      <SectionHeading number="01" title="Professional & Research Experience." />
      <div class="cv-timeline">
        {cvData.experience.map((exp) => (
          <article class="cv-card">
            <div class="cv-card-top">
              <div>
                <h3>{exp.role}</h3>
                <p class="cv-org">
                  <strong>{exp.organization}</strong>
                  {exp.division ? ` · ${exp.division}` : ''}
                </p>
              </div>
              <div class="cv-meta">
                <span class="pill">{exp.period}</span>
                <span class="muted">{exp.location}</span>
              </div>
            </div>
            <ul class="cv-list">
              {exp.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            <div class="cv-tags">
              {exp.tags.map((t) => (
                <span class="pill">{t}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section topline">
      <SectionHeading number="02" title="Academic Education." />
      <div class="cv-timeline">
        {cvData.education.map((edu) => (
          <article class="cv-card">
            <div class="cv-card-top">
              <div>
                <h3>{edu.degree}</h3>
                <p class="cv-org">
                  <strong>{edu.institution}</strong>
                </p>
              </div>
              <div class="cv-meta">
                <span class="pill">{edu.period}</span>
                <span class="muted">{edu.location}</span>
              </div>
            </div>
            <p style="margin-top:1rem;max-width:72ch">{edu.details}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section topline">
      <SectionHeading number="03" title="Competencies, Methods & Commitments." />
      <div class="cv-skills-grid">
        {Object.entries(cvData.skills).map(([category, items]) => (
          <article class="cv-skill-box">
            <h3>{category}</h3>
            <ul class="cv-list">
              {items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    {cvEntries.length > 0 && (
      <section class="section topline">
        <SectionHeading number="04" title="Additional CV Notes." />
        <ul class="page-list">
          {cvEntries.map((e) => (
            <li>
              <a href={href(`/cv/${e.id}/`)}>
                <h3>{e.data.title}</h3>
                <p>{e.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>
