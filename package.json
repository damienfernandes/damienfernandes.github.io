{
  "name": "damien-fernandes-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/validate-public.mjs && astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "check": "astro check",
    "publish": "node scripts/publish.mjs",
    "atlas:extract": "node scripts/extract-atlas.mjs",
    "atlas:manifest": "node scripts/create-manifest.mjs",
    "verify": "npm run test && npm run check && npm run build && node scripts/check-build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "astro": "7.4.0",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "5.9.3"
  }
}
